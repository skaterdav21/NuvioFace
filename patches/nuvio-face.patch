@@ -0,0 +1,46 @@
+package com.nuvio.app.car
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+
+/**
+ * Which way Nuvio registers with Android Auto. Both entry points are in the app; this turns one off so
+ * Android Auto only sees the other.
+ *
+ * - [NAVIGATION]: Car App Library navigation app (template buttons, car mic, resume prompt). Android Auto
+ *   treats a full-screen Nuvio as the navigation app, so Google Maps' cockpit directions go away.
+ * - [FULL_SCREEN_APP]: projection app like Fermata (floating buttons, car keyboard, real touches). Android Auto
+ *   treats Nuvio as an ordinary app, so Google Maps stays the navigation app for the cockpit.
+ */
+internal enum class CarMode(val label: String, val description: String) {
+    NAVIGATION(
+        "Navigation-style",
+        "Android Auto's own buttons, car mic voice search and the resume prompt. The cockpit loses Maps directions while Nuvio is full screen.",
+    ),
+    FULL_SCREEN_APP(
+        "Full-screen app (keeps Maps in the cockpit)",
+        "Runs like Fermata: Maps stays the navigation app, so the cockpit keeps its directions. Floating buttons and the car keyboard; voice search from the phone remote.",
+    );
+
+    companion object {
+        fun current(ctx: Context): CarMode {
+            val state = ctx.packageManager.getComponentEnabledSetting(component(ctx, NuvioCarAppService::class.java))
+            return if (state == PackageManager.COMPONENT_ENABLED_STATE_DISABLED) FULL_SCREEN_APP else NAVIGATION
+        }
+
+        fun set(ctx: Context, mode: CarMode) {
+            val pm = ctx.packageManager
+            fun toggle(cls: Class<*>, on: Boolean) = pm.setComponentEnabledSetting(
+                component(ctx, cls),
+                if (on) PackageManager.COMPONENT_ENABLED_STATE_ENABLED else PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                PackageManager.DONT_KILL_APP,
+            )
+            toggle(LegacyCarService::class.java, true)
+            toggle(NuvioCarAppService::class.java, mode == NAVIGATION)
+            CarLog.d("Car mode set to $mode")
+        }
+
+        private fun component(ctx: Context, cls: Class<*>) = ComponentName(ctx.packageName, cls.name)
+    }
+}
diff --git a/androidApp/src/main/kotlin/com/nuvio/app/car/CarNuvioWindow.kt b/androidApp/src/main/kotlin/com/nuvio/app/car/CarNuvioWindow.kt
new file mode 100644
index 0000000000000000000000000000000000000000..a05aa3ed93deda798f6e56b2f2f81efb7228ec05
--- /dev/null
+++ b/androidApp/src/main/kotlin/com/nuvio/app/car/CarNuvioWindow.kt
@@ -0,0 +1,197 @@
+package com.nuvio.app.car
+
+import android.app.Activity
+import android.app.Presentation
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.view.Display
+import android.view.KeyCharacterMap
+import android.view.KeyEvent
+import android.view.MotionEvent
+import android.view.View
+import android.widget.FrameLayout
+import androidx.activity.OnBackPressedDispatcher
+import androidx.activity.OnBackPressedDispatcherOwner
+import androidx.activity.result.ActivityResultRegistry
+import androidx.activity.result.ActivityResultRegistryOwner
+import androidx.activity.result.contract.ActivityResultContract
+import androidx.activity.setViewTreeOnBackPressedDispatcherOwner
+import androidx.core.app.ActivityOptionsCompat
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.LifecycleRegistry
+import androidx.lifecycle.ViewModelStore
+import androidx.lifecycle.ViewModelStoreOwner
+import androidx.lifecycle.setViewTreeLifecycleOwner
+import androidx.lifecycle.setViewTreeViewModelStoreOwner
+import androidx.navigationevent.DirectNavigationEventInput
+import androidx.navigationevent.NavigationEventDispatcher
+import androidx.navigationevent.NavigationEventDispatcherOwner
+import androidx.navigationevent.OnBackCompletedFallback
+import androidx.navigationevent.setViewTreeNavigationEventDispatcherOwner
+import androidx.savedstate.SavedStateRegistry
+import androidx.savedstate.SavedStateRegistryController
+import androidx.savedstate.SavedStateRegistryOwner
+import androidx.savedstate.setViewTreeSavedStateRegistryOwner
+import com.nuvio.app.NuvioEmbeddedView
+
+/**
+ * Nuvio on the car display, the way YT Auto shows YouTube: a Presentation window (which any app may show on
+ * its own virtual display) holding the whole Nuvio UI. Android 15+ refuses to start even an app's own
+ * activity on a virtual display it created, so this window plays the activity's part: it provides the
+ * lifecycle, view models, saved state, back handling and activity-result plumbing Nuvio's screens expect.
+ *
+ * [cover] sits above Nuvio for the "starting" and "hidden while driving" screens.
+ */
+internal class CarNuvioWindow(
+    ctx: Context,
+    display: Display,
+) : Presentation(ctx, display, android.R.style.Theme_Black_NoTitleBar_Fullscreen),
+    LifecycleOwner, ViewModelStoreOwner, SavedStateRegistryOwner, OnBackPressedDispatcherOwner,
+    ActivityResultRegistryOwner, NavigationEventDispatcherOwner {
+
+    private val lifecycleRegistry = LifecycleRegistry(this)
+    private val store = ViewModelStore()
+    private val savedState = SavedStateRegistryController.create(this)
+
+    override val lifecycle: Lifecycle get() = lifecycleRegistry
+    override val viewModelStore: ViewModelStore get() = store
+    override val savedStateRegistry: SavedStateRegistry get() = savedState.savedStateRegistry
+
+    // At Nuvio's root there's nothing to go back to: stay (closing would leave the car screen black).
+    override val onBackPressedDispatcher = OnBackPressedDispatcher { }
+
+    /**
+     * Back handling for Nuvio's navigation (NavDisplay and BackHandler), like ComponentActivity provides.
+     * Anything it doesn't handle falls through to [onBackPressedDispatcher].
+     */
+    override val navigationEventDispatcher = NavigationEventDispatcher(
+        OnBackCompletedFallback { onBackPressedDispatcher.onBackPressed() },
+    )
+
+    private val backInput: DirectNavigationEventInput by lazy {
+        DirectNavigationEventInput().also { navigationEventDispatcher.addInput(it) }
+    }
+
+    /** Pickers and external players open on the phone; Nuvio gets "cancelled" back right away. */
+    override val activityResultRegistry: ActivityResultRegistry = object : ActivityResultRegistry() {
+        override fun <I, O> onLaunch(
+            requestCode: Int,
+            contract: ActivityResultContract<I, O>,
+            input: I,
+            options: ActivityOptionsCompat?,
+        ) {
+            runCatching {
+                val intent = contract.createIntent(context, input).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                context.applicationContext.startActivity(intent)
+            }.onFailure { CarLog.d("Couldn't open ${contract.javaClass.simpleName} from the car", it) }
+            dispatchResult(requestCode, Activity.RESULT_CANCELED, null)
+        }
+    }
+
+    lateinit var cover: FrameLayout
+        private set
+    private var nuvio: View? = null
+    private var closing = false
+
+    init {
+        savedState.performAttach()
+        savedState.performRestore(null)
+        lifecycleRegistry.currentState = Lifecycle.State.CREATED
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val decor = window!!.decorView
+        decor.setViewTreeLifecycleOwner(this)
+        decor.setViewTreeViewModelStoreOwner(this)
+        decor.setViewTreeSavedStateRegistryOwner(this)
+        decor.setViewTreeOnBackPressedDispatcherOwner(this)
+        decor.setViewTreeNavigationEventDispatcherOwner(this)
+        window!!.setBackgroundDrawableResource(android.R.color.black)
+        window!!.setLayout(-1, -1)
+        val root = FrameLayout(context)
+        val view = NuvioEmbeddedView.create(context, this, this, this)
+        nuvio = view
+        root.addView(view, FrameLayout.LayoutParams(-1, -1))
+        cover = FrameLayout(context).apply { visibility = View.GONE }
+        root.addView(cover, FrameLayout.LayoutParams(-1, -1))
+        setContentView(root)
+        CarLog.d("Nuvio UI created on display ${display.displayId}")
+    }
+
+    override fun onStart() {
+        super.onStart()
+        lifecycleRegistry.currentState = Lifecycle.State.RESUMED
+    }
+
+    override fun onStop() {
+        lifecycleRegistry.currentState = Lifecycle.State.DESTROYED
+        store.clear()
+        super.onStop()
+    }
+
+    /**
+     * Presentations cancel themselves when the display's size or density changes. Nuvio's screens and playback
+     * would go with it, so only [close] (from the host) really dismisses this window.
+     */
+    override fun cancel() {
+        if (closing) super.cancel() else CarLog.d("Ignored automatic dismissal of the car window")
+    }
+
+    fun close() {
+        closing = true
+        runCatching { dismiss() }
+    }
+
+    /** Keeps Nuvio inside the part of the car screen that Android Auto's buttons never cover. */
+    fun setContentInsets(left: Int, top: Int, right: Int, bottom: Int) {
+        nuvio?.let { view ->
+            (view.layoutParams as? FrameLayout.LayoutParams)?.let { lp ->
+                if (lp.leftMargin != left || lp.topMargin != top || lp.rightMargin != right || lp.bottomMargin != bottom) {
+                    lp.setMargins(left, top, right, bottom)
+                    view.layoutParams = lp
+                }
+            }
+        }
+    }
+
+    fun injectTouch(event: MotionEvent) {
+        window?.decorView?.dispatchTouchEvent(event)
+    }
+
+    fun goBack() {
+        backInput.backCompleted()
+    }
+
+    fun hasFocusedField(): Boolean = currentFocus != null
+
+    /**
+     * Types [text] into the focused text field (tap Nuvio's search box first), replacing what's there, then
+     * presses Enter to run the search.
+     */
+    fun typeText(text: String): Boolean {
+        val decor = window?.decorView ?: return false
+        if (currentFocus == null) return false
+        val now = android.os.SystemClock.uptimeMillis()
+        fun key(code: Int, meta: Int = 0) {
+            decor.dispatchKeyEvent(KeyEvent(now, now, KeyEvent.ACTION_DOWN, code, 0, meta))
+            decor.dispatchKeyEvent(KeyEvent(now, now, KeyEvent.ACTION_UP, code, 0, meta))
+        }
+        key(KeyEvent.KEYCODE_A, KeyEvent.META_CTRL_ON or KeyEvent.META_CTRL_LEFT_ON)
+        key(KeyEvent.KEYCODE_DEL)
+        val map = KeyCharacterMap.load(KeyCharacterMap.VIRTUAL_KEYBOARD)
+        for (ch in text) {
+            val events = map.getEvents(charArrayOf(ch))
+            if (events != null) {
+                events.forEach { decor.dispatchKeyEvent(it) }
+            } else {
+                @Suppress("DEPRECATION")
+                decor.dispatchKeyEvent(KeyEvent(now, ch.toString(), KeyCharacterMap.VIRTUAL_KEYBOARD, 0))
+            }
+        }
+        key(KeyEvent.KEYCODE_ENTER)
+        return true
+    }
+}
diff --git a/androidApp/src/main/kotlin/com/nuvio/app/car/CarPrefs.kt b/androidApp/src/main/kotlin/com/nuvio/app/car/CarPrefs.kt
new file mode 100644
index 0000000000000000000000000000000000000000..016f63bd9a9aea3714ade85655b36e660bb82efb
--- /dev/null
+++ b/androidApp/src/main/kotlin/com/nuvio/app/car/CarPrefs.kt
@@ -0,0 +1,167 @@
+package com.nuvio.app.car
+
+import android.content.Context
+import com.nuvio.app.features.player.CarPlayerOverrides
+
+/**
+ * Nuvio Auto settings, shared by the phone setup screen and the car screen. Every in-car extra has its own
+ * switch so anything that misbehaves can be turned off on its own, and [basicMode] turns them all off at once.
+ */
+internal object CarPrefs {
+    private fun prefs(ctx: Context) = ctx.getSharedPreferences("nuvio_auto", Context.MODE_PRIVATE)
+
+    /** A boolean setting with a default; [get] honours [basicMode] for extras. */
+    class Flag(val key: String, val default: Boolean, val extra: Boolean = true) {
+        fun stored(ctx: Context): Boolean = prefs(ctx).getBoolean(key, default)
+        fun get(ctx: Context): Boolean = if (extra && basicMode(ctx)) false else stored(ctx)
+        fun set(ctx: Context, on: Boolean) {
+            prefs(ctx).edit().putBoolean(key, on).apply()
+        }
+    }
+
+    // ---- Master switch -------------------------------------------------------------------------------------------
+
+    /** Basic mode: Nuvio on the car screen with every extra off, for troubleshooting. */
+    fun basicMode(ctx: Context): Boolean = prefs(ctx).getBoolean("basicMode", false)
+
+    fun setBasicMode(ctx: Context, on: Boolean) {
+        prefs(ctx).edit().putBoolean("basicMode", on).apply()
+    }
+
+    // ---- Startup --------------------------------------------------------------------------------------------------
+
+    /** Profile the car opens into, skipping "Who's watching"; null asks as usual. */
+    fun carProfile(ctx: Context): Int? = if (basicMode(ctx)) null else storedCarProfile(ctx)
+
+    fun storedCarProfile(ctx: Context): Int? = prefs(ctx).getInt("carProfile", -1).takeIf { it >= 0 }
+
+    fun setCarProfile(ctx: Context, profileIndex: Int?) {
+        prefs(ctx).edit().putInt("carProfile", profileIndex ?: -1).apply()
+    }
+
+    val CAR_LOCK = Flag("carLock", false)
+    val RESUME_PROMPT = Flag("resumePrompt", true)
+
+    // ---- Playback -------------------------------------------------------------------------------------------------
+
+    val FILL_VIDEO = Flag("fillVideo", true)
+    val BIG_BUFFER = Flag("bigBuffer", true)
+    val AUTO_SKIP_INTROS = Flag("autoSkipIntros", true)
+    val AUTO_NEXT_EPISODE = Flag("autoNextEpisode", true)
+    val SUBTITLE_BACKGROUND = Flag("subtitleBackground", true)
+    val PAUSE_ON_DISCONNECT = Flag("pauseOnDisconnect", true)
+
+    val SUBTITLE_SCALES = floatArrayOf(1f, 1.2f, 1.4f, 1.6f, 1.8f)
+    val SUBTITLE_LABELS = arrayOf("Normal", "Large", "Larger", "Huge", "Huger")
+
+    fun subtitleScaleIndex(ctx: Context): Int =
+        prefs(ctx).getInt("subtitleScale", 2).coerceIn(0, SUBTITLE_SCALES.lastIndex)
+
+    fun setSubtitleScaleIndex(ctx: Context, index: Int) {
+        prefs(ctx).edit().putInt("subtitleScale", index).apply()
+    }
+
+    val STEERING_LABELS = linkedMapOf(
+        CarPlayerOverrides.SteeringMode.EPISODES to "Next episode / back 10 s",
+        CarPlayerOverrides.SteeringMode.SEEK to "Forward 30 s / back 10 s",
+        CarPlayerOverrides.SteeringMode.DEFAULT to "Nuvio's default",
+    )
+
+    fun steering(ctx: Context): CarPlayerOverrides.SteeringMode = runCatching {
+        CarPlayerOverrides.SteeringMode.valueOf(prefs(ctx).getString("steering", null) ?: "EPISODES")
+    }.getOrDefault(CarPlayerOverrides.SteeringMode.EPISODES)
+
+    fun setSteering(ctx: Context, mode: CarPlayerOverrides.SteeringMode) {
+        prefs(ctx).edit().putString("steering", mode.name).apply()
+    }
+
+    // ---- Data -----------------------------------------------------------------------------------------------------
+
+    /** When to prefer streams at or under 720p while Nuvio is on the car screen. */
+    enum class DataSaver(val label: String) {
+        ALWAYS("Always in the car"),
+        MOBILE_DATA("Only on mobile data"),
+        OFF("Off"),
+    }
+
+    fun dataSaver(ctx: Context): DataSaver = if (basicMode(ctx)) DataSaver.OFF else storedDataSaver(ctx)
+
+    fun storedDataSaver(ctx: Context): DataSaver {
+        val p = prefs(ctx)
+        val stored = p.getString("dataSaverMode", null)
+        if (stored != null) return runCatching { DataSaver.valueOf(stored) }.getOrDefault(DataSaver.ALWAYS)
+        return if (p.contains("dataSaver") && !p.getBoolean("dataSaver", true)) DataSaver.OFF else DataSaver.ALWAYS
+    }
+
+    fun setDataSaver(ctx: Context, mode: DataSaver) {
+        prefs(ctx).edit().putString("dataSaverMode", mode.name).apply()
+    }
+
+    const val DATA_SAVER_MAX_HEIGHT = 720
+
+    // ---- Car screen -----------------------------------------------------------------------------------------------
+
+    /** Car UI size, as a multiplier on the head unit's dpi: bigger dpi means bigger text and buttons. */
+    val SIZE_SCALES = floatArrayOf(0.8f, 0.9f, 1.0f, 1.15f, 1.3f, 1.5f)
+    val SIZE_LABELS = arrayOf("Smallest", "Small", "Normal", "Large", "Larger", "Largest")
+
+    fun sizeIndex(ctx: Context): Int = prefs(ctx).getInt("size", 2).coerceIn(0, SIZE_SCALES.lastIndex)
+
+    fun setSizeIndex(ctx: Context, index: Int) {
+        prefs(ctx).edit().putInt("size", index.coerceIn(0, SIZE_SCALES.lastIndex)).apply()
+    }
+
+    fun nextSize(ctx: Context): Int {
+        val next = (sizeIndex(ctx) + 1) % SIZE_SCALES.size
+        setSizeIndex(ctx, next)
+        return next
+    }
+
+    fun scaledDpi(ctx: Context, carDpi: Int): Int = (carDpi * SIZE_SCALES[sizeIndex(ctx)]).toInt().coerceAtLeast(80)
+
+    val HIDE_WHILE_DRIVING = Flag("hideWhileDriving", true, extra = false)
+    val AVOID_CAR_BUTTONS = Flag("avoidButtons2", false, extra = false)
+    val HIDE_STATUS_OVERLAY = Flag("hideStatusOverlay", true)
+    val BAR_AT_BOTTOM = Flag("barAtBottom", true, extra = false)
+
+    val BAR_TIMEOUTS = longArrayOf(3_000L, 5_000L, 8_000L, 0L)
+    val BAR_TIMEOUT_LABELS = arrayOf("3 seconds", "5 seconds", "8 seconds", "Always show")
+
+    fun barTimeoutIndex(ctx: Context): Int = prefs(ctx).getInt("barTimeout", 1).coerceIn(0, BAR_TIMEOUTS.lastIndex)
+
+    fun setBarTimeoutIndex(ctx: Context, index: Int) {
+        prefs(ctx).edit().putInt("barTimeout", index).apply()
+    }
+
+    // ---- Phone ----------------------------------------------------------------------------------------------------
+
+    val REMOTE_NOTIFICATION = Flag("remoteNotification", true)
+    val CLUSTER_MIRROR = Flag("clusterMirror", false)
+
+    // ---- Accessors used around the app ----------------------------------------------------------------------------
+
+    fun hideVideoWhileDriving(ctx: Context) = HIDE_WHILE_DRIVING.get(ctx)
+    fun avoidCarButtons(ctx: Context) = AVOID_CAR_BUTTONS.get(ctx)
+    fun resumePrompt(ctx: Context) = RESUME_PROMPT.get(ctx)
+    fun remoteNotification(ctx: Context) = REMOTE_NOTIFICATION.get(ctx)
+    fun clusterMirror(ctx: Context) = CLUSTER_MIRROR.get(ctx)
+    fun fillVideo(ctx: Context) = FILL_VIDEO.get(ctx)
+
+    /** Profile names seen last time Nuvio was signed in, for the profile picker when Nuvio isn't loaded. */
+    fun cachedProfiles(ctx: Context): List<Pair<Int, String>> =
+        prefs(ctx).getString("profileCache", null).orEmpty().lines().mapNotNull { line ->
+            val index = line.substringBefore('\t').toIntOrNull() ?: return@mapNotNull null
+            index to line.substringAfter('\t')
+        }
+
+    fun cacheProfiles(ctx: Context, profiles: List<Pair<Int, String>>) {
+        if (profiles.isEmpty()) return
+        prefs(ctx).edit().putString("profileCache", profiles.joinToString("\n") { "${it.first}\t${it.second}" }).apply()
+    }
+
+    /** Back to defaults (the profile list cache is kept). */
+    fun reset(ctx: Context) {
+        val keepProfiles = prefs(ctx).getString("profileCache", null)
+        prefs(ctx).edit().clear().putString("profileCache", keepProfiles).apply()
+    }
+}
diff --git a/androidApp/src/main/kotlin/com/nuvio/app/car/CarRemoteActivity.kt b/androidApp/src/main/kotlin/com/nuvio/app/car/CarRemoteActivity.kt
