+                        0.25f to Color.Black.copy(alpha = 0.25f),
+                        0.7f to Color.Black.copy(alpha = 0.25f),
+                        1f to Color.Black.copy(alpha = 0.8f),
+                    ),
+                ),
+        )
+
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(horizontal = horizontalSafePadding),
+        ) {
+            // ---- Top bar ----
+            Row(
