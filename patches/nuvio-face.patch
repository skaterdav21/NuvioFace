+                }
+            }
+
+            // ---- Center: rewind / play-pause / forward ----
+            Row(
+                modifier = Modifier.align(Alignment.Center),
+                horizontalArrangement = Arrangement.spacedBy(if (compact) 40.dp else 88.dp),
