+        var failed by remember(imageUrl) { mutableStateOf(imageUrl.isNullOrBlank()) }
+        if (!failed) {
+            AsyncImage(
+                model = imageUrl,
+                contentDescription = item.name,
+                modifier = Modifier.fillMaxSize(),
