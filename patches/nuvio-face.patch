+                    .fillMaxWidth()
+                    .windowInsetsPadding(WindowInsets.safeContent.only(WindowInsetsSides.Top))
+                    .padding(horizontal = sidePadding, vertical = 8.dp),
+                verticalAlignment = Alignment.CenterVertically,
