+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+private fun NetflixPoster(
+    item: MetaPreview,
+    landscape: Boolean,
+    watched: Boolean,
+    onClick: () -> Unit,
+    onLongClick: (() -> Unit)?,
+    width: Dp = if (landscape) 186.dp else NetflixPosterWidth,
