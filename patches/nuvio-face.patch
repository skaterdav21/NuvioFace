+        Spacer(Modifier.width(12.dp))
+        Column(Modifier.weight(1f)) {
+            Text("Nuvio remote", fontSize = 24.sp, fontWeight = FontWeight.Bold, color = Color.White)
+            Text("Controls Nuvio on your car screen", fontSize = 13.sp, color = Muted)
+        }
