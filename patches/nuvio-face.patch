+@Composable
+internal fun NetflixHomeContent(
+    listState: LazyListState,
+    profileName: String?,
+    heroItems: List<MetaPreview>,
+    showHero: Boolean,
+    heroLoading: Boolean,
+    rows: List<NetflixHomeRow>,
+    continueWatchingItems: List<ContinueWatchingItem>,
+    upcomingItems: List<ContinueWatchingItem>,
+    upcomingTitle: String,
+    isLoading: Boolean,
+    emptyContent: (@Composable () -> Unit)?,
+    watchedKeys: Set<String>,
+    fullyWatchedSeriesKeys: Set<String>,
+    animateCollectionGifs: Boolean,
+    onPosterClick: ((MetaPreview) -> Unit)?,
+    onPosterLongClick: ((MetaPreview) -> Unit)?,
+    onContinueWatchingClick: ((ContinueWatchingItem) -> Unit)?,
+    onContinueWatchingLongPress: ((ContinueWatchingItem) -> Unit)?,
+    onFolderClick: ((collectionId: String, folderId: String) -> Unit)?,
+    modifier: Modifier = Modifier,
+) {
+    val newAndHot by NetflixNav.newAndHot.collectAsStateWithLifecycle()
+    BoxWithConstraints(modifier = modifier.fillMaxSize()) {
+        if (newAndHot) {
+            PlatformBackHandler(enabled = true) { NetflixNav.newAndHot.value = false }
+            NetflixNewAndHotContent(
+                rows = rows,
+                upcomingItems = upcomingItems,
+                wide = NuvioDevice.isTv || maxWidth >= 768.dp,
+                onPosterClick = onPosterClick,
+                onUpcomingClick = onContinueWatchingClick,
+            )
+        } else if (NuvioDevice.isTv || maxWidth >= 768.dp) {
+        NetflixTvHomeContent(
+            listState = listState,
+            heroItems = heroItems,
+            showHero = showHero,
+            heroLoading = heroLoading,
+            rows = rows,
+            continueWatchingItems = continueWatchingItems,
+            upcomingItems = upcomingItems,
+            continueTitle = if (profileName.isNullOrBlank()) "Continue Watching" else "Continue Watching for $profileName",
+            upcomingTitle = upcomingTitle,
+            isLoading = isLoading,
+            emptyContent = emptyContent,
+            watchedKeys = watchedKeys,
+            fullyWatchedSeriesKeys = fullyWatchedSeriesKeys,
+            animateCollectionGifs = animateCollectionGifs,
+            onPosterClick = onPosterClick,
+            onPosterLongClick = onPosterLongClick,
+            onContinueWatchingClick = onContinueWatchingClick,
+            onContinueWatchingLongPress = onContinueWatchingLongPress,
+            onFolderClick = onFolderClick,
+            modifier = Modifier,
+        )
+        } else {
+            NetflixPhoneHomeContent(
+                listState = listState,
+                profileName = profileName,
+                heroItems = heroItems,
+                showHero = showHero,
+                heroLoading = heroLoading,
+                rows = rows,
+                continueWatchingItems = continueWatchingItems,
+                upcomingItems = upcomingItems,
+                upcomingTitle = upcomingTitle,
