+/** Focus target for the play/pause button, so the TV remote can jump into the controls. */
+internal val LocalNetflixPlayerFocus = staticCompositionLocalOf<FocusRequester?> { null }
+
+/**
+ * Netflix-style playback controls: back + centered title on top, big rewind / play / forward in
+ * the middle, a red scrubber with time remaining, and a labelled action row along the bottom.
+ * Every action of the stock controls is still here.
+ */
+@Composable
+internal fun NetflixPlayerControls(
+    title: String,
+    seasonNumber: Int?,
+    episodeNumber: Int?,
+    episodeTitle: String?,
+    playbackSnapshot: PlayerPlaybackSnapshot,
+    displayedPositionMs: Long,
+    resizeMode: PlayerResizeMode,
+    showRemainingTime: Boolean,
+    onRuntimeClick: () -> Unit,
+    onNextEpisodeClick: (() -> Unit)?,
+    onInteraction: () -> Unit,
+    showPlaybackControls: Boolean,
+    onLockToggle: () -> Unit,
+    onBack: () -> Unit,
+    onPartyClick: (() -> Unit)?,
+    partyActive: Boolean,
+    onTogglePlayback: () -> Unit,
+    onSeekBack: () -> Unit,
+    onSeekForward: () -> Unit,
+    onResizeModeClick: () -> Unit,
+    onSpeedClick: () -> Unit,
+    onSubtitleClick: () -> Unit,
+    onAudioClick: () -> Unit,
+    onVideoSettingsClick: (() -> Unit)?,
+    onSourcesClick: (() -> Unit)?,
+    onEpisodesClick: (() -> Unit)?,
+    chapters: List<PlayerChapter>,
+    onChaptersClick: (() -> Unit)?,
+    onOpenInExternalPlayer: (() -> Unit)?,
+    onSubmitIntroClick: (() -> Unit)?,
+    onSwitchEngineClick: (() -> Unit)?,
+    onStreamInfoClick: () -> Unit,
+    parentalWarnings: List<ParentalWarning>,
+    showParentalGuide: Boolean,
+    onParentalGuideAnimationComplete: () -> Unit,
+    onScrubChange: (Long) -> Unit,
+    onScrubFinished: (Long) -> Unit,
+    horizontalSafePadding: Dp,
+    modifier: Modifier = Modifier,
+) {
+    fun act(block: () -> Unit): () -> Unit = {
+        onInteraction()
+        block()
+    }
+
+    val remoteFocus = LocalNetflixPlayerFocus.current
+    BoxWithConstraints(
+        modifier = modifier
+            .fillMaxSize()
+            .onPreviewKeyEvent { event ->
+                if (event.type == KeyEventType.KeyDown) onInteraction()
+                false
+            },
+    ) {
+        val compact = maxWidth < 600.dp
+        val sidePadding = if (compact) 12.dp else 28.dp
+
+        ParentalGuideOverlay(
+            warnings = parentalWarnings,
+            isVisible = showParentalGuide,
+            onAnimationComplete = onParentalGuideAnimationComplete,
+            contentPadding = PaddingValues(horizontal = 32.dp, vertical = 24.dp),
+            modifier = Modifier.align(Alignment.TopStart),
+        )
+        if (!showPlaybackControls) return@BoxWithConstraints
+
+        // Netflix dims the whole frame a little, with deeper shade top and bottom.
+        Box(
+            Modifier
+                .fillMaxSize()
+                .background(
+                    Brush.verticalGradient(
