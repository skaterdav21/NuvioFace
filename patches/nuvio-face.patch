+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+private fun NetflixPosterRow(
+    title: String,
+    entries: List<MetaPreview>,
+    watchedKeys: Set<String>,
+    fullyWatchedSeriesKeys: Set<String>,
