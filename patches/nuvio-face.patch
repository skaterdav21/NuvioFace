index ae97eccaa76cdf2bee444abfbfe11478a925192b..d5b27891c9025a0b149c833827adc2fa147aabc5 100644
--- a/androidApp/build.gradle.kts
+++ b/androidApp/build.gradle.kts
@@ -67,7 +67,8 @@ android {
     }
 
     defaultConfig {
-        applicationId = "com.nuvio.app"
+        // Nuvio Auto builds pass -Pnuvio.applicationId=... so they install next to the official app.
+        applicationId = providers.gradleProperty("nuvio.applicationId").orNull ?: "com.nuvio.app"
         minSdk = libs.versions.android.minSdk.get().toInt()
         targetSdk = libs.versions.android.targetSdk.get().toInt()
         versionCode = releaseAppVersionCode
@@ -132,6 +133,7 @@ android {
             proguardFiles(
                 getDefaultProguardFile("proguard-android-optimize.txt"),
                 "../composeApp/proguard-rules.pro",
+                "proguard-car.pro",
             )
             signingConfig = signingConfigs.getByName("release")
             ndk {
@@ -204,6 +206,12 @@ dependencies {
     implementation(project(":composeApp"))
     implementation(libs.androidx.appcompat)
     implementation(libs.compose.runtime)
+    // Nuvio Auto: Android Auto navigation surface (see com.nuvio.app.car).
+    implementation("androidx.car.app:app:1.4.0")
+    implementation(libs.androidx.activity.compose)
+    // Nuvio Auto: unofficial Android Auto SDK (projection CarActivity), taken from Fermata via YT Auto.
+    implementation(files("libs/aauto.aar"))
+    implementation("androidx.recyclerview:recyclerview:1.4.0")
     coreLibraryDesugaring(libs.desugar.jdk.libs)
     baselineProfile(project(":baselineprofile"))
     debugImplementation(libs.compose.uiTooling)
